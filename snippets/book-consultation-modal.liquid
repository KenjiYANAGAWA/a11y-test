<style>
  /* Drawer Modal Container */
.modal__content {
  background-color: #fff;
  padding: 2rem;
  max-width: 500px;
  margin: auto;
  overflow-y: auto;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  box-sizing: border-box;
}

.modal__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 1.5rem;
  border: none;
  background: transparent;
  cursor: pointer;
}

.modal-step {
  display: none;
}

.modal-step:not([hidden]) {
  display: block;
  animation: fadeIn 0.3s ease-in-out;
}

.modal__footer {
  display: flex;
  justify-content: space-between;
  margin-top: 1.5rem;
}

.modal__button,
.modal__button-secondary {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  border-radius: 4px;
}

.modal__button {
  background-color: #2a2eac;
  color: #fff;
}

.modal__button-secondary {
  background: transparent;
  border: 2px solid #2a2eac;
  color: #2a2eac;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

</style>

<!-- Modal Consultation Drawer -->
<x-drawer id="consultation-drawer" open-from="right" template="drawer-default-template">
  <div slot="content" class="modal__content" role="dialog" aria-labelledby="modal-title" aria-modal="true">
    <!-- Close Button -->
    <button id="close-modal" aria-label="Close" class="modal__close">&times;</button>

    <!-- Step 1: User Information -->
    <div class="modal-step" id="step-1" data-step>
      <h2 id="modal-title" class="modal__title">Let us help you find your perfect earphones!</h2>
      <form id="user-info-form" class="modal__form">
        <div class="form-group">
          <label for="full_name">Full Name *</label>
          <input type="text" id="full_name" required />
        </div>
        <div class="form-group">
          <label for="email">Email *</label>
          <input type="email" id="email" required />
        </div>
        <div class="modal__footer">
          <button id="next-to-step-2" class="modal__button" type="button">Next</button>
        </div>
      </form>
    </div>

    <!-- Step 2: Date & Time Selection -->
    <div class="modal-step" id="step-2" data-step hidden>
      <h2>Select a Date & Time</h2>
      <input type="datetime-local" id="date-time" required />
      <div class="modal__footer">
        <button id="back-to-step-1" class="modal__button-secondary" type="button">Back</button>
        <button id="next-to-step-3" class="modal__button" type="button" disabled>Next</button>
      </div>
    </div>

    <!-- Step 3: Review Details -->
    <div class="modal-step" id="step-3" data-step hidden>
      <h2>Review Your Details</h2>
      <p><strong>Name:</strong> <span id="review-name"></span></p>
      <p><strong>Date & Time:</strong> <span id="review-datetime"></span></p>
      <div class="modal__footer">
        <button id="back-to-step-2" class="modal__button-secondary" type="button">Back</button>
        <button id="confirm-step" class="modal__button" type="button">Confirm</button>
      </div>
    </div>

    <!-- Step 4: Thank You -->
    <div class="modal-step" id="step-4" data-step hidden>
      <h2>Thank You!</h2>
      <p>Your booking is confirmed!</p>
      <button id="close-modal-final" class="modal__button" type="button">Done</button>
    </div>
  </div>
</x-drawer>
