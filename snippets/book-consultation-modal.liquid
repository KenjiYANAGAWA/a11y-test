<style>
  /* Drawer Modal Container */
.modal__content {
  background-color: #fff;
  padding: 2rem;
  max-width: 500px;
  margin: auto;
  overflow-y: auto;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  border-radius: 8px;
  box-sizing: border-box;
}

.modal__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 1.5rem;
  border: none;
  background: transparent;
  cursor: pointer;
}

.modal-step {
  display: none;
}

.modal-step:not([hidden]) {
  display: block;
  animation: fadeIn 0.3s ease-in-out;
}

.modal__footer {
  display: flex;
  justify-content: space-between;
  margin-top: 1.5rem;
}

.modal__button,
.modal__button-secondary {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  border: none;
  cursor: pointer;
  border-radius: 4px;
}

.modal__button {
  background-color: #2a2eac;
  color: #fff;
}

.modal__button-secondary {
  background: transparent;
  border: 2px solid #2a2eac;
  color: #2a2eac;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

</style>

<!-- snippets/modal-consultation.liquid -->
<x-drawer id="consultation-drawer" open-from="right" template="drawer-default-template">
  <div slot="content" class="drawer__content" role="dialog" aria-labelledby="drawer-title" aria-modal="true">
    <!-- Close Button -->
    <button type="button" id="close-modal" class="drawer__close" aria-label="Close">&times;</button>

    <!-- Step 1 -->
    <div id="step-1" class="drawer-step">
      <h2 id="drawer-title" class="drawer__title">Let us help you find your perfect earphones!</h2>
      <form id="step-1-form">
        <label for="full_name">Full Name *</label>
        <input type="text" id="full_name" required />

        <label for="email">Email *</label>
        <input type="email" id="email" required />

        <button type="button" id="next-to-step-2" class="drawer__button">Next</button>
      </form>
    </div>

    <!-- Step 2 -->
    <div id="step-2" class="drawer-step" hidden>
      <h2>Select a Date & Time</h2>
      <input type="datetime-local" id="date-time" required />
      <button type="button" id="back-to-step-1" class="drawer__button-secondary">Back</button>
      <button type="button" id="next-to-step-3" class="drawer__button" disabled>Next</button>
    </div>

    <!-- Step 3 -->
    <div id="step-3" class="drawer-step" hidden>
      <h2>Review Your Details</h2>
      <p>Name: <span id="review-name"></span></p>
      <p>Email: <span id="review-email"></span></p>
      <p>Date & Time: <span id="review-datetime"></span></p>
      <button type="button" id="back-to-step-2" class="drawer__button-secondary">Back</button>
      <button type="button" id="confirm-step" class="drawer__button">Confirm</button>
    </div>

    <!-- Step 4 -->
    <div id="step-4" class="drawer-step" hidden>
      <h2>Thank You!</h2>
      <p>Your booking is confirmed.</p>
      <button type="button" id="close-modal-final" class="drawer__button">Done</button>
    </div>
  </div>
</x-drawer>
