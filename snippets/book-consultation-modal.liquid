<style>
/* Modal Overlay */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  justify-content: center;
  align-items: center;
}

/* Modal Content */
.modal__content {
  background-color: #fff;
  padding: 2rem;
  border-radius: 8px;
  width: 100%;
  max-width: 40rem;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  position: relative;
}

/* Close Button */
.modal__close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 1.5rem;
  font-weight: bold;
  color: #333;
  cursor: pointer;
}

/* Modal Titles */
.modal__title {
  font-size: 1.5rem;
  font-weight: bold;
  margin-bottom: 1rem;
}

/* Form */
.modal__form {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  align-items: center;
}

.form-group {
  grid-column: span 2;
}

.form-group label {
  display: block;
  font-weight: 500;
  margin-bottom: 0.5rem;
}

.phone-group {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.phone-group select {
  flex: 1;
}

.phone-group input {
  flex: 2;
}

.form-note {
  font-size: 0.8rem;
  color: #666;
}

/* Buttons */
.modal__footer {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  margin-top: 1.5rem;
}

.modal__button,
.modal__button-secondary {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  border-radius: 4px;
  cursor: pointer;
}

.modal__button {
  background-color: #2a2eac;
  color: #fff;
  border: none;
}

.modal__button-secondary {
  background: transparent;
  border: 2px solid #2a2eac;
  color: #2a2eac;
}

.modal__button:hover,
.modal__button-secondary:hover {
  opacity: 0.8;
}

/* Hidden Steps */
.modal-step[hidden] {
  display: none;
}

/* Responsive */
@media (max-width: 768px) {
  .modal__form {
    grid-template-columns: 1fr;
  }

  .phone-group {
    flex-direction: column;
    gap: 1rem;
  }
}

  /* General Input Styling */
.modal__form input,
.modal__form select {
  width: 100%;
  padding: 0.75rem;
  font-size: 1rem;
  border: 1px solid #ccc; /* Neutral border */
  border-radius: 4px;
  box-shadow: none;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

/* Focus State */
.modal__form input:focus,
.modal__form select:focus {
  border-color: #2a2eac; /* Highlight border */
  box-shadow: 0 0 0 3px rgba(42, 46, 172, 0.2); /* Subtle focus ring */
}

/* Placeholder Styling */
.modal__form input::placeholder {
  color: #aaa; /* Light gray placeholder */
}

/* Phone Group Alignment */
.phone-group {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.phone-group select {
  flex: 1; /* Adjusts the dropdown width */
}

.phone-group input[type="tel"] {
  flex: 2; /* Adjusts the phone input width */
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group.date-time {
  width: 50%;
  margin: 0 auto;
}

/* Date Input Container */
.date-input-container {
  position: relative;
  display: flex;
  align-items: center;
}

.date-input {
  width: 100%;
  padding: 0.75rem;
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  outline: none;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.date-input:focus {
  border-color: #2a2eac;
  box-shadow: 0 0 0 3px rgba(42, 46, 172, 0.2);
}

/* Disabled State for Next Button */
.modal__button[disabled] {
  background-color: #ddd;
  cursor: not-allowed;
}

</style>

<!-- Drawer Component -->
<drawer-template id="consultation-drawer" open-from="right" template="drawer-default-template">
  <div class="modal__content" slot="content" role="dialog" aria-labelledby="modal-title" aria-modal="true">
    <!-- Close Button -->
    <button class="modal__close" id="close-modal" aria-label="Close">&times;</button>

    <!-- Step 1: User Information -->
    <div class="modal-step" id="step-1" data-step>
      <h2 id="modal-title" class="modal__title">Let us help you find your perfect earphones!</h2>
      <form id="user-info-form" class="modal__form" novalidate>
        <div class="form-group">
          <label for="full_name">Full Name *</label>
          <input type="text" id="full_name" name="full_name" aria-required="true" required />
        </div>
        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" aria-required="true" required />
        </div>
        <div class="form-group">
          <label for="phone">Phone Number *</label>
          <div class="phone-group">
            <select id="country-code" name="country_code" aria-label="Country code" required>
              <option value="+1" selected>+1 (US)</option>
            </select>
            <input type="tel" id="phone" name="phone" placeholder="123 456 7890" aria-required="true" required />
          </div>
        </div>
        <div class="modal__footer">
          <button type="button" class="modal__button" id="next-to-step-2">Next</button>
        </div>
      </form>
    </div>

    <!-- Step 2: Date & Time Selection -->
    <div class="modal-step" id="step-2" data-step hidden>
      <h2 class="modal__title">Select a Date and Time</h2>
      <div class="form-group date-time">
        <label for="date-time">Date & Time *</label>
        <input type="datetime-local" id="date-time" aria-required="true" required />
      </div>
      <div class="modal__footer">
        <button type="button" class="modal__button-secondary" id="back-to-step-1">Back</button>
        <button type="button" class="modal__button" id="next-to-step-3" disabled>Next</button>
      </div>
    </div>

    <!-- Step 3: Review and Confirm -->
    <div class="modal-step" id="step-3" data-step hidden>
      <h2 class="modal__title">Review Your Details</h2>
      <p><strong>Name:</strong> <span id="review-name"></span></p>
      <p><strong>Email:</strong> <span id="review-email"></span></p>
      <p><strong>Phone:</strong> <span id="review-phone"></span></p>
      <p><strong>Date & Time:</strong> <span id="review-datetime"></span></p>

      <div class="modal__footer">
        <button type="button" class="modal__button-secondary" id="back-to-step-2">Back</button>
        <button type="button" class="modal__button" id="confirm-step">Confirm</button>
      </div>
    </div>

    <!-- Step 4: Thank You -->
    <div class="modal-step" id="step-4" data-step hidden>
      <h2 class="modal__title">Thank You!</h2>
      <p>Your consultation is confirmed. We’ll send you a confirmation email shortly.</p>
      <div class="modal__footer">
        <button type="button" class="modal__button" id="close-modal-final">Done</button>
      </div>
    </div>
  </div>
</drawer-template>
