<style>
.drawer__content {
  background: white;
  padding: 2rem;
  border-radius: 8px;
  max-width: 500px;
  margin: auto;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.drawer__title {
  font-size: 1.5rem;
  margin-bottom: 1rem;
}

.drawer__button,
.drawer__button-secondary {
  padding: 0.75rem 1.5rem;
  border-radius: 4px;
  border: none;
  cursor: pointer;
  margin-top: 1rem;
}

.drawer__button {
  background-color: #2a2eac;
  color: white;
}

.drawer__button-secondary {
  background: transparent;
  border: 1px solid #2a2eac;
  color: #2a2eac;
}

</style>

<!-- snippets/modal-consultation.liquid -->
<book-consultation-drawer id="book-consultation-drawer" open-from="right" template="drawer-default-template">
  <div slot="content" class="drawer__content" role="dialog" aria-labelledby="consultation-title" aria-modal="true">
    <!-- Close Button -->
    <button type="button" id="close-book-drawer" class="drawer__close" aria-label="Close">&times;</button>

    <!-- Step 1: User Information -->
    <div class="drawer-step" id="step-1">
      <h2 id="consultation-title" class="drawer__title">Book Your Consultation</h2>
      <form id="step-1-form">
        <label for="full_name">Full Name *</label>
        <input type="text" id="full_name" name="full_name" required />

        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required />

        <button type="button" id="next-to-step-2" class="drawer__button">Next</button>
      </form>
    </div>

    <!-- Step 2: Date & Time -->
    <div class="drawer-step" id="step-2" hidden>
      <h2>Select a Date & Time</h2>
      <input type="datetime-local" id="datetime" required />
      <button type="button" id="back-to-step-1" class="drawer__button-secondary">Back</button>
      <button type="button" id="next-to-step-3" class="drawer__button">Next</button>
    </div>

    <!-- Step 3: Confirmation -->
    <div class="drawer-step" id="step-3" hidden>
      <h2>Confirm Your Details</h2>
      <p><strong>Name:</strong> <span id="review-name"></span></p>
      <p><strong>Email:</strong> <span id="review-email"></span></p>
      <p><strong>Date & Time:</strong> <span id="review-datetime"></span></p>
      <button type="button" id="confirm-booking" class="drawer__button">Confirm</button>
    </div>

    <!-- Step 4: Thank You -->
    <div class="drawer-step" id="step-4" hidden>
      <h2>Thank You!</h2>
      <p>Your consultation is booked successfully.</p>
      <button type="button" id="close-booking" class="drawer__button">Done</button>
    </div>
  </div>
</book-consultation-drawer>

