<style>
  /* Drawer Modal Container */
.modal__content {
  background-color: #fff;
  padding: 2rem;
  border-radius: 8px;
  width: 100%;
  max-width: 40rem;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  position: relative;
  overflow-y: auto;
  height: 100vh; /* Make Drawer fullscreen on mobile */
  box-sizing: border-box;
}

/* Modal Close Button */
.modal__close {
  position: absolute;
  top: 10px;
  right: 15px;
  font-size: 1.5rem;
  font-weight: bold;
  color: #333;
  cursor: pointer;
  border: none;
  background: transparent;
}

/* Modal Step Titles */
.modal__title {
  font-size: 1.75rem;
  font-weight: bold;
  margin-bottom: 1rem;
}

/* Form Group Styling */
.modal__form .form-group {
  margin-bottom: 1.5rem;
}

.modal__form label {
  display: block;
  font-weight: 500;
  margin-bottom: 0.5rem;
}

.modal__form input,
.modal__form select {
  width: 100%;
  padding: 0.75rem;
  font-size: 1rem;
  border: 1px solid #ccc;
  border-radius: 4px;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.modal__form input:focus,
.modal__form select:focus {
  border-color: #2a2eac;
  box-shadow: 0 0 0 3px rgba(42, 46, 172, 0.2);
}

/* Phone Group */
.phone-group {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.phone-group select {
  flex: 1;
}

.phone-group input {
  flex: 2;
}

/* Buttons Footer */
.modal__footer {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  margin-top: 1.5rem;
}

.modal__button,
.modal__button-secondary {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  border-radius: 4px;
  cursor: pointer;
}

.modal__button {
  background-color: #2a2eac;
  color: #fff;
  border: none;
  transition: opacity 0.2s ease;
}

.modal__button:hover {
  opacity: 0.8;
}

.modal__button-secondary {
  background: transparent;
  border: 2px solid #2a2eac;
  color: #2a2eac;
  transition: opacity 0.2s ease;
}

.modal__button-secondary:hover {
  opacity: 0.8;
}

/* Hidden Steps */
.modal-step {
  display: none;
}

.modal-step:not([hidden]) {
  display: block;
  animation: fadeIn 0.3s ease-out;
}

/* Responsive for Mobile */
@media (max-width: 768px) {
  .modal__content {
    padding: 1.5rem;
  }

  .modal__form input,
  .modal__form select {
    padding: 0.5rem;
    font-size: 0.9rem;
  }

  .phone-group {
    flex-direction: column;
    gap: 1rem;
  }
}

/* Fade Animation */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

</style>

<!-- modal-consultation.liquid -->
<dialog-element id="consultation-drawer" class="drawer" open-from="right" role="dialog" aria-labelledby="modal-title">
  <div slot="content" class="modal__content">
    <!-- Close Button -->
    <button id="close-modal" aria-label="Close" class="modal__close">&times;</button>

    <!-- Step 1 -->
    <div class="modal-step" id="step-1" data-step>
      <h2 id="modal-title">Let us help you find your perfect earphones!</h2>
      <form id="user-info-form" class="modal__form">
        <div class="form-group">
          <label for="full_name">Full Name *</label>
          <input type="text" id="full_name" required />
        </div>
        <div class="modal__footer">
          <button id="next-to-step-2" type="button">Next</button>
        </div>
      </form>
    </div>

    <!-- Step 2 -->
    <div class="modal-step" id="step-2" data-step hidden>
      <h2>Select a Date & Time</h2>
      <input type="datetime-local" id="date-time" required />
      <div class="modal__footer">
        <button id="back-to-step-1" type="button">Back</button>
        <button id="next-to-step-3" type="button" disabled>Next</button>
      </div>
    </div>

    <!-- Step 3 -->
    <div class="modal-step" id="step-3" data-step hidden>
      <h2>Review Your Details</h2>
      <p>Name: <span id="review-name"></span></p>
      <p>Date & Time: <span id="review-datetime"></span></p>
      <div class="modal__footer">
        <button id="back-to-step-2" type="button">Back</button>
        <button id="confirm-step" type="button">Confirm</button>
      </div>
    </div>

    <!-- Step 4 -->
    <div class="modal-step" id="step-4" data-step hidden>
      <h2>Thank You!</h2>
      <p>Your booking has been confirmed.</p>
      <button id="close-modal-final" type="button">Done</button>
    </div>
  </div>
</dialog-element>
